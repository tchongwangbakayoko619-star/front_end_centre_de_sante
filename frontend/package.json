{
  "name": "cs2-health-frontend",
  "version": "1.0.0",
  "description": "CS² Health — Design System & Django Ready Frontend Prototype",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --watch",
    "format:css": "prettier --write static/css/**/*.css",
    "format": "prettier --write static/css/**/*.css static/js/**/*.js templates/**/*.html"
  },
  "keywords": [
    "cs2-health",
    "django",
    "tailwindcss",
    "design-system",
    "medical"
  ],
  "author": "CS² Health Team",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19"
  }
}
